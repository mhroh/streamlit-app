# Claude API 키
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# 구글 시트 URL (프롬프트 읽기용)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/your_sheet_id/edit

# 앱 ID (반/그룹 구분용: idebate, idebate01, idebate02, ... idebate30)
APP_ID=idebate

# 구글 드라이브 폴더 ID (학생 기록 저장용, 선택사항)
# 폴더 URL: https://drive.google.com/drive/folders/FOLDER_ID
RECORD_FOLDER_ID=your_folder_id_here

# 구글 서비스 계정 JSON 파일 경로 (로컬 개발용)
# google_credentials.json 파일을 프로젝트 루트에 저장하세요
